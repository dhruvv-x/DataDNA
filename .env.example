# Copy to .env and change values. .env must never be committed.
POSTGRES_USER=compliance
POSTGRES_PASSWORD=change_me
POSTGRES_DB=compliance
# Used by the backend and by the tests (the tests use a separate database named <POSTGRES_DB>_test).
DATABASE_URL=postgresql://compliance:change_me@localhost:5432/compliance

# --- Auth (S3) ---
# REQUIRED. At least 32 random characters. Create one with:
#   python3 -c "import secrets; print('JWT_SECRET=' + secrets.token_urlsafe(48))" >> .env
JWT_SECRET=
# Optional (defaults shown):
# ACCESS_TOKEN_MINUTES=30
# REFRESH_TOKEN_DAYS=7
# BCRYPT_COST=12
# LOCKOUT_THRESHOLD=5
# LOCKOUT_MINUTES=15
# Set COOKIE_SECURE=true only when the site runs on https (browsers drop Secure cookies on plain http).
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# URL path the login cookie is sent to. Leave as is unless the API sits behind a /api prefix
# (the Vite dev proxy and most reverse proxies do). Then set it to /api/auth, or logins will not stick.
# COOKIE_PATH=/auth
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads (S4) ---
# Folder for uploaded files. Keep it OUTSIDE the git repo. Default: ~/datadna_storage
# STORAGE_DIR=~/datadna_storage
# Global upload size cap in MB (a checklist item can set a lower one). Default 50.
# MAX_UPLOAD_MB=50

# --- Rule engine (S5) ---
# How often the API re-checks deadlines by itself (MISSING / INCOMPLETE flags). 0 = off. Default 10.
# RULES_SWEEP_MINUTES=10

# --- Trust score (S6) ---
# The Content part of the score stays off until the cross-document checks exist (S9). While off, its weight
# is shared among Completeness, Timeliness and Format. Set to true only when content checks are live.
# CONTENT_SCORING_ENABLED=false
