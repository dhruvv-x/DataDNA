# Copy this file to .env.local. It is git-ignored. Restart `npm run dev` after changing it.
# The browser calls /api on the same address as the page; the Vite dev server forwards it to the backend.
# (This also needs COOKIE_PATH=/api/auth in ~/datadna/.env, otherwise the login does not stick.)
VITE_API_BASE=/api
# Only if the backend is not on this machine's port 8000:
# VITE_PROXY_TARGET=http://127.0.0.1:8000
